{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/classic-cars/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bodoni Moda|Work Sans|Cormorant Garamond))/i]",
        "message": "Font not provided by the design system. Available: Bodoni Moda, Work Sans, Cormorant Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|icon|children|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, icon, children, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassicCarCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|description|image|key|ref|className|style|children)$/]",
        "message": "<ClassicCarCard> doesn't accept that prop. Declared props: title, price, description, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateTimeField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|date|time|onDateChange|onTimeChange|key|ref|className|style|children)$/]",
        "message": "<DateTimeField> doesn't accept that prop. Declared props: label, date, time, onDateChange, onTimeChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='DriverCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|role|since|languages|bio|key|ref|className|style|children)$/]",
        "message": "<DriverCard> doesn't accept that prop. Declared props: photo, name, role, since, languages, bio."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElectricFleetIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|key|ref|className|style|children)$/]",
        "message": "<ElectricFleetIndicator> doesn't accept that prop. Declared props: percent."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|key|ref|className|style|children)$/]",
        "message": "<FAQItem> doesn't accept that prop. Declared props: question, answer."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingContact'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|whatsapp|key|ref|className|style|children)$/]",
        "message": "<FloatingContact> doesn't accept that prop. Declared props: phone, whatsapp."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: logoSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|error|helper|type|icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, onChange, error, helper, type, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PassengerSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:adults|children|onAdultsChange|onChildrenChange|key|ref|className|style|children)$/]",
        "message": "<PassengerSelector> doesn't accept that prop. Declared props: adults, children, onAdultsChange, onChildrenChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|duration|maxPassengers|vehicle|included|excluded|image|onSelect|key|ref|className|style|children)$/]",
        "message": "<PriceCard> doesn't accept that prop. Declared props: title, price, duration, maxPassengers, vehicle, included, excluded, image, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|price|duration|onSelect|key|ref|className|style|children)$/]",
        "message": "<RouteCard> doesn't accept that prop. Declared props: from, to, price, duration, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|location|rating|quote|source|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: name, location, rating, quote, source."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItineraryStop'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|title|description|key|ref|className|style|children)$/]",
        "message": "<ItineraryStop> doesn't accept that prop. Declared props: time, title, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:reviewScore|reviewCount|since|partners|key|ref|className|style|children)$/]",
        "message": "<TrustBar> doesn't accept that prop. Declared props: reviewScore, reviewCount, since, partners."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
